{
  "name": "重写",
  "description": "基于原始内容重新撰写",
  "version": "1.3",
  "author": "墨韵AI",
  "updated": "2026-05-11",
  "tags": ["rewrite", "generation"],
  "variables": {
    "original_content": {
      "type": "textarea",
      "label": "原始内容",
      "source": "章节正文",
      "required": true
    },
    "story_state": {
      "type": "textarea",
      "label": "当前故事状态",
      "source": "story-state.md",
      "required": false
    },
    "style_guide": {
      "type": "textarea",
      "label": "文风指南",
      "source": "style-guide.md",
      "required": false
    },
    "rewrite_goal": {
      "type": "textarea",
      "label": "重写目标",
      "source": "ch-meta.json",
      "required": false
    },
    "keep_elements": {
      "type": "textarea",
      "label": "需要保留的元素",
      "source": "ch-meta.json",
      "required": false
    }
  }
}
