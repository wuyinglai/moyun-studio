{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Required Beat Validator Case",
  "type": "object",
  "required": ["id", "title", "context", "facts", "required_beats", "style_constraints", "expected_risks", "target_length"],
  "properties": {
    "id": {"type": "string"},
    "title": {"type": "string"},
    "context": {"type": "string"},
    "facts": {"type": "array", "items": {"type": "string"}},
    "required_beats": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "text", "must_appear"],
        "properties": {
          "id": {"type": "string"},
          "text": {"type": "string"},
          "must_appear": {"type": "boolean"},
          "type": {"type": "string"},
          "keywords": {"type": "array", "items": {"type": "string"}},
          "acceptable_paraphrases": {"type": "array", "items": {"type": "string"}},
          "required_semantic_condition": {"type": "string"},
          "forbidden_semantic_condition": {"type": "string"},
          "terminal_position_required": {"type": "boolean"},
          "knowledge_boundary": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "character_may_know": {"type": "array", "items": {"type": "string"}},
              "character_must_not_know": {"type": "array", "items": {"type": "string"}},
              "reader_may_know": {"type": "array", "items": {"type": "string"}},
              "reader_must_not_know": {"type": "array", "items": {"type": "string"}},
              "reader_reveal_allowed": {"type": "boolean"}
            }
          },
          "violation_threshold": {"type": "string"},
          "forbidden_keywords": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "style_constraints": {"type": "array", "items": {"type": "string"}},
    "expected_risks": {"type": "array", "items": {"type": "string"}},
    "target_length": {"type": "string"}
  }
}
