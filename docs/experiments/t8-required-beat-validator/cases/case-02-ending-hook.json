{
  "id": "case-02-ending-hook",
  "title": "结尾钩子",
  "context": "林澈和沈知夏躲进旧港站档案室，门外追踪者的声音渐渐远去。走廊深处忽然安静下来。",
  "facts": [
    "林澈和沈知夏仍在旧港站地下层。",
    "门后的来人身份不能揭晓。",
    "本场只制造下一场景悬念。"
  ],
  "required_beats": [
    {
      "id": "beat-1",
      "text": "门后传来熟悉脚步声。",
      "must_appear": true,
      "keywords": [
        "熟悉",
        "脚步"
      ],
      "acceptable_paraphrases": [
        "熟悉的步子",
        "听过的脚步",
        "那阵步声很熟",
        "门外的脚步像旧记忆"
      ],
      "terminal_position_required": false,
      "required_semantic_condition": "A familiar footstep sound must come from behind the door or outside the room."
    },
    {
      "id": "beat-2",
      "text": "林澈认出脚步声。",
      "must_appear": true,
      "keywords": [
        "林澈",
        "认出",
        "听出"
      ],
      "acceptable_paraphrases": [
        "他听出了这脚步声",
        "不用看也知道那是谁的步子",
        "那步伐他太熟了",
        "这频率他曾听过"
      ],
      "terminal_position_required": false,
      "required_semantic_condition": "Lin Che must recognize or strongly identify the footstep sound, but the text must not name the visitor for the reader.",
      "knowledge_boundary": {
        "character_may_know": [
          "脚步声属于熟人",
          "来人身份的个人判断"
        ],
        "reader_must_not_know": [
          "来人姓名",
          "来人身份",
          "来人与主角具体关系"
        ],
        "reader_reveal_allowed": false
      }
    },
    {
      "id": "beat-3",
      "text": "结尾停在林澈抬头。",
      "must_appear": true,
      "keywords": [
        "林澈抬头",
        "抬起头"
      ],
      "acceptable_paraphrases": [
        "他缓缓抬头",
        "林澈慢慢抬起头",
        "林澈抬眼",
        "他抬起视线"
      ],
      "terminal_position_required": true,
      "required_semantic_condition": "The final narrative beat should stop on Lin Che raising his head or gaze."
    },
    {
      "id": "forbid-1",
      "text": "不能揭晓来人身份。",
      "must_appear": false,
      "type": "forbidden",
      "forbidden_keywords": [
        "来人是",
        "那是",
        "父亲",
        "导师",
        "队长",
        "开口说道",
        "解释道"
      ],
      "acceptable_paraphrases": [],
      "terminal_position_required": false,
      "forbidden_semantic_condition": "Do not reveal the visitor name, role, organization, family relation, or other specific identity to the reader. Character suspicion is allowed if not named.",
      "knowledge_boundary": {
        "character_may_know": [
          "来人可能是谁",
          "脚步声熟悉"
        ],
        "reader_must_not_know": [
          "来人姓名",
          "身份职位",
          "组织归属",
          "亲属关系"
        ],
        "reader_reveal_allowed": false
      },
      "violation_threshold": "explicit_name_role_or_specific_identity_hint"
    }
  ],
  "style_constraints": [
    "悬疑克制",
    "不要突然煽情",
    "不要段子化"
  ],
  "expected_risks": [
    "模型容易漏掉林澈认出脚步声",
    "模型容易提前写出来人身份"
  ],
  "target_length": "600-1000 Chinese characters"
}
