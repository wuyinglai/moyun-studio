# 墨韵配置文件
# 复制此文件为 .env 并填入实际配置（Windows: copy .env.example .env）
# ⚠️ 重要：.env 包含 API Key 等敏感信息，已加入 .gitignore，请勿提交。

# ─── 默认安全行为 ──────────────────────────────────────────────────
# - 默认不调用真实 LLM（AI 功能需显式配置 API Key 后才生效）
# - 高风险操作（polish/rewrite/chat-edit）默认生成 candidate，不覆盖正文
# - dry-run 不写入任何文件
# - 真实 LLM 冒烟测试默认关闭（需 ALLOW_REAL_LLM_SMOKE=true 且 project_id 以 __llm_smoke_ 前缀）
# - Batch 真实 smoke 永久禁止

# ─── LLM 配置（AI 功能必需）──────────────────────────────────────
# 支持 openai / anthropic / ollama / custom
LLM_PROVIDER=openai
LLM_API_KEY=your-api-key-here
LLM_MODEL=gpt-4
LLM_API_BASE=https://api.openai.com/v1

# ─── 本地 LLM（Ollama 等 OpenAI-compatible 本地服务）示例 ───────
# LLM_PROVIDER=ollama
# LLM_API_KEY=ollama
# LLM_MODEL=qwen2.5
# LLM_API_BASE=http://localhost:11434/v1

# ─── 服务配置 ─────────────────────────────────────────────────────
# HOST=127.0.0.1
# PORT=8000
# DEBUG=false

# ─── 工作区配置 ───────────────────────────────────────────────────
# WORKSPACE_PATH=./workspace

# ─── 安全配置 ─────────────────────────────────────────────────────
# ALLOW_LAN_ACCESS=false

# ─── 真实 LLM 冒烟测试开关（默认关闭）───────────────────────────
# 注意：当前 Settings 无 env_prefix，因此使用 ALLOW_REAL_LLM_SMOKE（非 MOYUN_ 前缀）。
# 仅在开发者测试环境中使用；需要同时使用 project_id 以 `__llm_smoke_` 为前缀。
# 普通用户请勿开启。
# ALLOW_REAL_LLM_SMOKE=false
# LLM_SMOKE_MAX_TOKENS=300

# ─── 代理配置（Windows 下遇到 SSL 连接问题时启用）──────────────────
# 注意：此项由 backend/main.py 直接读取环境变量，使用 MOYUN_ 前缀。
# MOYUN_DISABLE_PROXY_DETECTION=true
