# 墨韵配置文件
# 复制此文件为 .env 并填入实际配置
# cp .env.example .env

# ─── LLM 配置（AI 功能必需）──────────────────────────────────────
# 支持 openai / anthropic / ollama / custom
LLM_PROVIDER=openai
LLM_API_KEY=your-api-key-here
LLM_MODEL=gpt-4
LLM_API_BASE=https://api.openai.com/v1

# ─── 服务配置 ─────────────────────────────────────────────────────
# HOST=127.0.0.1
# PORT=8000
# DEBUG=false

# ─── 工作区配置 ───────────────────────────────────────────────────
# WORKSPACE_PATH=./workspace

# ─── 安全配置 ─────────────────────────────────────────────────────
# ALLOW_LAN_ACCESS=false

# ─── 代理配置（Windows 下遇到 SSL 连接问题时启用）──────────────────
# MOYUN_DISABLE_PROXY_DETECTION=true
