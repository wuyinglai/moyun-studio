{
  "name": "大纲生成",
  "description": "创作完整、详细、可执行的大纲",
  "version": "1.3",
  "author": "墨韵AI",
  "updated": "2026-05-14",
  "tags": ["outline", "generation"],
  "variables": {
    "genre": {
      "type": "text",
      "label": "题材",
      "source": "project-meta.json",
      "required": true
    },
    "theme": {
      "type": "text",
      "label": "核心主题",
      "source": "project-meta.json",
      "required": true
    },
    "protagonist": {
      "type": "textarea",
      "label": "主角设定",
      "source": "extracted/characters/main.md",
      "required": true
    },
    "scale": {
      "type": "select",
      "label": "目标规模",
      "source": "project-meta.json",
      "options": ["短篇（1-3万）", "中篇（5-10万）", "长篇（15-20万）", "超长篇（30万+）"],
      "required": true
    },
    "name": {
      "type": "text",
      "label": "项目名称",
      "source": "pipeline extra_vars",
      "required": false
    },
    "tone": {
      "type": "text",
      "label": "基调",
      "source": "project-meta.json",
      "required": false
    },
    "target_word_count": {
      "type": "number",
      "label": "目标字数（数字）",
      "source": "pipeline extra_vars",
      "required": false
    },
    "file_content": {
      "type": "textarea",
      "label": "已有蓝图内容",
      "source": "目标文件内容",
      "required": false
    }
  }
}
