{
  "name": "缩写",
  "description": "缩写文本",
  "version": "1.3",
  "author": "墨韵AI",
  "updated": "2026-05-11",
  "tags": ["shorten", "transform"],
  "variables": {
    "content": {
      "type": "textarea",
      "label": "原文",
      "source": "章节正文",
      "required": true
    },
    "style_guide": {
      "type": "textarea",
      "label": "文风指南",
      "source": "style-guide.md",
      "required": false
    },
    "shorten_type": {
      "type": "select",
      "label": "缩写类型",
      "source": "ch-meta.json",
      "options": ["精简冗余", "压缩篇幅", "摘要提取", "去除细节", "保留核心"],
      "default": "保留核心",
      "required": false
    },
    "target_length": {
      "type": "select",
      "label": "目标长度",
      "source": "ch-meta.json",
      "options": ["70%", "50%", "30%"],
      "default": "50%",
      "required": false
    }
  }
}
