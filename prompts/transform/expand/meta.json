{
  "name": "扩写",
  "description": "扩写文本",
  "version": "1.3",
  "author": "墨韵AI",
  "updated": "2026-05-11",
  "tags": ["expand", "transform"],
  "variables": {
    "content": {
      "type": "textarea",
      "label": "原文",
      "source": "章节正文",
      "required": true
    },
    "style_guide": {
      "type": "textarea",
      "label": "文风指南",
      "source": "style-guide.md",
      "required": false
    },
    "expand_type": {
      "type": "select",
      "label": "扩写类型",
      "source": "ch-meta.json",
      "options": ["增加细节", "扩展场景", "丰富对话", "深化心理", "详细过程", "全面丰富"],
      "default": "全面丰富",
      "required": false
    },
    "target_length": {
      "type": "select",
      "label": "目标长度",
      "source": "ch-meta.json",
      "options": ["1.5倍", "2倍", "3倍"],
      "default": "2倍",
      "required": false
    }
  }
}
